# Runtime configuration for the agent's tools. Building the agent needs none of these values.
LAB_BASE_URL=http://127.0.0.1:3000
# Which tools a session gets: simulated (the default) exposes get_logs;
# daily_capture exposes get_daily_logs and get_daily_http_observations instead.
LAB_TOOL_MODE=simulated
# simulated: use a token from pnpm lab init. Keep tokens local and out of model instructions.
LAB_TRIAL_TOKEN=
# daily_capture: a capture access grant's token, and the capture and evidence file it must serve.
LAB_DAILY_CAPTURE_TOKEN=
LAB_DAILY_CAPTURE_ID=
LAB_DAILY_EVIDENCE_SHA256=
