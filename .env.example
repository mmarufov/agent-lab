# Local simulation only. Docker exposes Postgres on the loopback interface.
DATABASE_URL=postgresql://agent_lab:agent_lab_local@127.0.0.1:55432/agent_lab
LAB_BASE_URL=http://127.0.0.1:3000

# Separate reviewer calls use standard Gateway credentials, not Eve's local login.
# Add a real key only to ignored .env.local. This reviewer-only variable avoids
# changing Eve's connection. Standard AI_GATEWAY_API_KEY / VERCEL_OIDC_TOKEN also work.
# LAB_REVIEW_GATEWAY_API_KEY=
# LAB_REVIEW_MODEL=openai/gpt-6.1-sol
